# diablo-3 — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# The server's IPv4 address as the players see it (announced in NAT discovery
# replies). Must be an IP address, not a hostname.
NEXTENDO_HOST=127.0.0.1
# Demonware auth (HTTPS). sni-router sends *.demonware.net here (BACKEND_D3).
AUTH_PORT=8460
# Set to 1 if this server sits behind a proxy that speaks the PROXY protocol
# (sni-router with SNI_PROXY_PROTOCOL=1): the auth then sees the player's IP.
NEXTENDO_PROXY_PROTOCOL=0
# Lobby (TCP) and NAT probes (UDP). The game uses 3074.
LOBBY_PORTS=3074,3075,3076,3077,3078,3079,3080
NAT_PORT=3074
# TLS cert/key for the auth endpoint (server-side; these are ignored by git).
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Nextendo account integration ---
# URL of the Nextendo account API (online-check, presence).
NEXTENDO_ACCOUNT_URL=https://nextendo.network
# Require a valid Nextendo account to play online (1 = enforce, 0 = log only).
NEXTENDO_REQUIRE_ACCOUNT=1
# Require a cryptographically SIGNED identity token at login (1 = enforce).
NEXTENDO_REQUIRE_SIGNED_TOKEN=0
# Require a valid lobby ticket: 1 refuses the all-zero handshake key, so a
# client presenting no ticket cannot complete the handshake unidentified. Leave
# 0 while any client still issues an older ticket whose lobby-key field is null.
NEXTENDO_REQUIRE_TICKET=0

# --- Secrets (set these to strong random values in production) ---
# Shared key for internal service-to-service calls.
NEXTENDO_INTERNAL_KEY=change-me
# Token-signing / verification secret. Either set the value directly...
NEXTENDO_SECRET=change-me
# ...or point to a file that contains it (hex).
NEXTENDO_SECRET_FILE=

# --- Monitoring ---
# /api/stats for nextendo-dashboard (?key=DASH_TOKEN), /healthz, /pubfiles/.
DASH_PORT=8093
DASH_TOKEN=change-me
# SNI hostname advertised on the monitoring dashboard (cosmetic).
NEXTENDO_SNI_HOST=

# --- Diablo III ---
# Expire a public game whose host is still connected but has stopped touching it
# (seconds). This clears an abandoned game that would otherwise stay findable and
# be rejected on join. 0 disables the sweep. The default is generous so an active
# game is never dropped.
D3_SESSION_TTL=900
# Season, community events and blacklist are generated from this file.
D3_PUBFILES_CONFIG=pubfiles.json
D3_PUBFILES=pubfiles
# Tickets and player identities issued at login.
D3_SESSIONS=sessions
# Raw captures of auth bodies and lobby frames: off, or a directory.
D3_DUMPS=off
# 1 = log every decrypted lobby message as a hex dump.
D3_VERBOSE=0
# Persisted service state (user data, hero files, counters, mail, leaderboards).
# A directory keeps it across restarts; "off" (or empty) keeps it in memory only.
D3_STATE=state
# 1 = turn on the best-effort typed replies for the services whose wire layout
# is not captured from the Switch client yet (bdStats leaderboards, bdStorage
# file reads, bdCounter, bdMessaging, user-data query). OFF by default: storing
# state and answering an empty success is known-safe, while an unrecognised
# reply shape can mark a service unavailable in the client. Turn it on only with
# a capture running to confirm the layouts (see STATUS.md).
D3_FRAMED_REPLIES=0
# Local stack only: baas-proxy log, read to map console friend device ids.
BAASPROXY_LOG=
# Challenge Rift blobs (challengerift_config.dat and challengerift_NN.dat, from
# d3hack's release zip: config/d3hack-nx/rift_data/). Not part of the repository.
# Without a challengerift_config.dat in this folder, rifts are not served.
D3_RIFTDATA=riftdata

# --- Crash Team Racing Nitro-Fueled (title 5775) ---
# RSA-2048 private key (PEM, exponent 65537) that signs auth replies for CTR.
# Needs openssl on the PATH. The public key goes in the CTR client mod. Unset =
# CTR replies are unsigned and CTR cannot log in. Diablo III is not affected.
CTR_AUTH_SIGNING_KEY=
# 1 = also send the lobby migration message (off by default: the game then waits
# for a migration and closes after about 12 seconds).
CTR_MIGRATE=0
